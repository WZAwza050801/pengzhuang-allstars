{
  "name": "pengzhuang-allstars",
  "version": "1.0.0",
  "private": true,
  "description": "碰撞全明星 怀旧复刻：竖屏 5v5 弹射足球，浏览器联机约战",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:art && npm run build:client && npm run build:server",
    "build:art": "tsx tools/gen-art.ts",
    "build:avatars": "python art/gen_placeholders.py",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.js --packages=external --sourcemap",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "calibrate": "tsx tools/calibrate.ts",
    "test:physics": "tsx tools/physics-tests.ts",
    "test:net": "tsx tools/net-tests.ts",
    "test:e2e": "node tools/e2e-browser.mjs",
    "test": "npm run test:physics && npm run test:net",
    "backup": "tsx tools/backup.ts"
  },
  "dependencies": {
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus": "0.16.5",
    "colyseus.js": "0.16.22",
    "express": "4.21.2",
    "planck": "1.4.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
