{
  "name": "pengzhuang-allstars",
  "version": "1.0.0",
  "private": true,
  "description": "碰撞全明星 怀旧复刻：竖屏 5v5 弹射足球，浏览器联机约战",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "preinstall": "node tools/check-toolchain.mjs",
    "check:toolchain": "node tools/check-toolchain.mjs",
    "test:config": "vitest run --project unit tests/config.test.ts",
    "check:config": "tsx tools/check-config.ts",
    "dev": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:art && npm run build:client && npm run build:server",
    "build:art": "tsx tools/gen-art.ts",
    "build:avatars": "python art/gen_placeholders.py",
    "build:client": "npm run check:ui-tokens && npm run check:assets && npm run check:balance-data && vite build --config client/vite.config.ts",
    "build:server": "npm run check:balance-data && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.js --packages=external --sourcemap",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "calibrate": "tsx tools/calibrate.ts",
    "test:physics": "tsx tools/physics-tests.ts",
    "test:net": "tsx tools/net-tests.ts",
    "test:e2e": "npm run build:test-client && node tools/e2e-browser.mjs",
    "test:qa": "npm run build && node tools/qa-runner.mjs",
    "test:web-layout": "node tools/web-layout-browser.mjs",
    "test:web-shell": "node tools/web-shell-browser.mjs",
    "test:web-performance": "npm run build:test-client && node tools/web-performance-browser.mjs",
    "test": "npm run test:physics && npm run test:net",
    "backup": "tsx tools/backup.ts",
    "lint": "eslint .",
    "format:check": "node tools/format.mjs",
    "format": "node tools/format.mjs --write",
    "test:unit": "vitest run --project unit",
    "audit:assets": "node tools/audit-assets.mjs",
    "check": "npm run check:toolchain && npm run check:boundaries && npm run check:ui-tokens && npm run lint && npm run format:check && npm run typecheck && npm run check:config && node tools/check-plan.mjs && npm run audit:assets && npm run test:unit && npm run test:contract && npm run docs:contracts -- --check && npm run check:game-config && npm run check:assets && npm run check:asset-package && npm run check:balance-data && npm run check:balance-mapping && npm run check:skills && npm run check:economy && npm run check:balance-experiment",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:contract": "vitest run --project contract",
    "docs:contracts": "tsx tools/export-contracts.ts",
    "test:integration": "node tools/run-pg-tests.mjs",
    "db:migrate": "tsx tools/migrate.ts",
    "db:rollback": "tsx tools/migrate.ts --down",
    "check:game-config": "tsx tools/export-game-config.ts --check",
    "export:game-config": "tsx tools/export-game-config.ts --write",
    "test:field": "vitest run --project unit tests/field*.test.ts",
    "assets:catalog": "tsx tools/asset-catalog.ts --write",
    "check:assets": "tsx tools/asset-catalog.ts",
    "build:test-client": "npm run check:assets && vite build --config client/vite.config.ts --mode test --outDir ../work/test-client",
    "check:balance-data": "tsx tools/validate-balance-data.ts",
    "balance:data": "tsx tools/validate-balance-data.ts --write",
    "balance:mapping": "tsx tools/export-balance-mapping.ts --write",
    "check:balance-mapping": "tsx tools/export-balance-mapping.ts",
    "skills:rules": "tsx tools/export-skill-rules.ts --write",
    "check:skills": "tsx tools/export-skill-rules.ts",
    "ai:bench": "tsx tools/ai-latency.ts",
    "test:ai-browser": "node tools/ai-browser.mjs",
    "balance:economy": "tsx tools/economy-simulation.ts --write",
    "check:economy": "tsx tools/economy-simulation.ts",
    "test:balance": "vitest run --project unit tests/balance tests/economy tests/skills.test.ts tests/modes.test.ts tests/releases.test.ts tests/experiments.test.ts",
    "balance:experiment": "tsx tools/balance-experiments.ts --write",
    "check:balance-experiment": "tsx tools/balance-experiments.ts --check",
    "check:balance-release": "tsx tools/balance-experiments.ts --check --require-publishable",
    "cards:atlas": "tsx tools/card-atlas.ts",
    "check:cards": "tsx tools/card-atlas.ts --check",
    "test:cards-browser": "node tools/card-browser.mjs",
    "ui:assets": "tsx tools/ui-assets.ts",
    "check:ui-assets": "tsx tools/ui-assets.ts --check",
    "test:ui-browser": "node tools/ui-browser.mjs",
    "ui:tokens": "tsx tools/ui-tokens.ts --write",
    "check:ui-tokens": "tsx tools/ui-tokens.ts",
    "test:components-browser": "node tools/components-browser.mjs",
    "assets:variants": "tsx tools/asset-variants.ts",
    "check:asset-variants": "tsx tools/asset-variants.ts --check",
    "assets:package": "tsx tools/asset-packages.ts --write",
    "check:asset-package": "tsx tools/asset-packages.ts",
    "check:asset-release": "tsx tools/asset-packages.ts --release",
    "test:assets-browser": "node tools/assets-browser.mjs",
    "test:asset-matrix": "node tools/asset-matrix.mjs",
    "assets:readiness": "tsx tools/asset-readiness.ts --write",
    "check:asset-readiness": "tsx tools/asset-readiness.ts",
    "test:workflow-browser": "node tools/workflow-browser.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "@noble/hashes": "2.4.0",
    "@pengzhuang/contracts": "1.0.0",
    "@pengzhuang/game-core": "1.0.0",
    "@pengzhuang/persistence": "1.0.0",
    "@pengzhuang/platform": "1.0.0",
    "colyseus": "0.16.5",
    "colyseus.js": "0.16.22",
    "express": "4.21.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "planck": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.21",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.25.12",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "ws": "8.23.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
