# Local environment template. Contains no secrets and must never be filled with real tokens or keys.
# The game server does NOT load .env files by itself. Export the variables in your shell,
# or start it with: node --env-file=.env --import tsx server/index.ts

# TCP port of the game server (default 2567). The Vite dev proxy in client/vite.config.ts expects 2567.
PORT=2567

# Used by the stage-C browser client only (not read by the server).
# Empty = same-origin "/colyseus" through the Vite dev proxy. Direct connection example: ws://localhost:2567
VITE_SERVER_URL=

# Runtime values: local / test / staging / production. NODE_ENV=production cannot override to local.
APP_ENV=local
PUBLIC_ORIGIN=http://localhost:2567
ALLOWED_ORIGINS=http://localhost:2567
ROOM_STORE_DIR=data/rooms
DEV_AUTH_BYPASS=false
COOKIE_SECURE=false
LOG_LEVEL=info

# Required for staging/production. Export real values from the deployment secret manager.
# Never put a filled environment file in Git. Use a base64url random key with at least 32 bytes.
# DATABASE_URL=
# SESSION_SIGNING_KEY=
# ASSET_ORIGIN=https://assets.example.org

# Test runs only read TEST_DATABASE_URL, never fall back to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://localhost/pengzhuang_test

# Disabled until the real provider is configured and verified.
WECHAT_ENABLED=false
EMAIL_PROVIDER=disabled
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# Enabled WeChat also requires DATABASE_URL and a strong SESSION_SIGNING_KEY.
# Real acceptance is opt-in and only uses TEST_DATABASE_URL; see docs/engineering/wechat-identity.md.
# SMTP_URL=
# MAIL_FROM=no-reply@example.org
# Local SMTP capture: EMAIL_PROVIDER=mailpit and SMTP_URL=smtp://127.0.0.1:1025.
# Enabled email also requires SESSION_SIGNING_KEY, kept stable to decrypt pending mail jobs.

# Account deletion: local/test defaults to enabled with a 168-hour engineering grace period.
# staging/production defaults to disabled; enabling requires an explicitly reviewed policy/version and grace.
# Disabled also pauses queued erasures; status/cancel and ban expiry still operate.
# ACCOUNT_DELETION_ENABLED=false
# ACCOUNT_DELETION_GRACE_HOURS=168
# ACCOUNT_RETENTION_POLICY=your-reviewed-policy-version
